<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.24.xsd">

    <changeSet id="001" author="limit-service">
        <createTable tableName="user_limits">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="user_id" type="BIGINT">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="daily_limit" type="DECIMAL(10,2)">
                <constraints nullable="false"/>
            </column>
            <column name="remaining_limit" type="DECIMAL(10,2)">
                <constraints nullable="false"/>
            </column>
            <column name="limit_date" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
        
        <createIndex tableName="user_limits" indexName="idx_user_limits_user_id">
            <column name="user_id"/>
        </createIndex>
        
        <createIndex tableName="user_limits" indexName="idx_user_limits_date">
            <column name="limit_date"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
